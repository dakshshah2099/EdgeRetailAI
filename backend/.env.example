# ==============================================================================
# Edge Retail AI - Local / Laptop POC Environment Configuration
# ==============================================================================

# System & Security
DEBUG_MODE=true

# Camera Streaming & RTSP Authentication
# Note: Camera stream sources are configured per camera in Calibrate Zones / config.yaml
RTSP_USERNAME=
RTSP_PASSWORD=
RTSP_TRANSPORT=tcp

# YOLO Person Detection & Tracking
YOLO_MODEL=models/yolo26n.onnx
YOLO_INPUT_SIZE=640
YOLO_INFERENCE_FPS=5.0
YOLO_INTRA_OP_THREADS=3
DETECTION_CONFIDENCE_THRESHOLD=0.50

# Analytics Hyperparameters
LOW_STOCK_CONFIDENCE_THRESHOLD=0.60
SHELF_ANALYSIS_INTERVAL=1.0
QUEUE_CONGESTION_LENGTH=4
FOOTFALL_TRACKER_MODE=directional
FOOTFALL_EMIT_ON=zone_enter
HEATMAP_CELL_SIZE=20

# Storage & Configuration Paths
DATABASE_PATH=retail.db
CONFIG_PATH=config.yaml

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
POLLING_INTERVAL_SEC=3
