# ==============================================================================
# Edge Retail AI - Raspberry Pi 4B Embedded POC Environment Configuration
# ==============================================================================

# System & Security
DEBUG_MODE=true

# Camera & Video Streaming Source
# Options: 0 for USB/CSI camera, rtsp://<ip>:<port>/<path>, or path/to/video.mp4
CAMERA_SOURCE=0
RTSP_USERNAME=
RTSP_PASSWORD=
RTSP_TRANSPORT=tcp

# YOLO Person Detection & Tracking (INT8 dynamic quantization for Pi 4B ARM64)
YOLO_MODEL=models/yolo26n_int8.onnx
YOLO_INPUT_SIZE=640
YOLO_INFERENCE_FPS=5.0
YOLO_INTRA_OP_THREADS=3
DETECTION_CONFIDENCE_THRESHOLD=0.40

# Analytics Hyperparameters
LOW_STOCK_CONFIDENCE_THRESHOLD=0.60
SHELF_ANALYSIS_INTERVAL=1.0
QUEUE_CONGESTION_LENGTH=4
FOOTFALL_TRACKER_MODE=directional
FOOTFALL_EMIT_ON=zone_enter
HEATMAP_CELL_SIZE=20

# Storage & Configuration Paths
DATABASE_PATH=retail.db
CONFIG_PATH=config.yaml

# Server & Network Configuration (0.0.0.0 allows LAN dashboard access)
HOST=0.0.0.0
PORT=8000
POLLING_INTERVAL_SEC=3
