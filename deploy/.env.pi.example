# Raspberry Pi 4B Hardware POC Environment Configuration
# Copy this file to .env.pi or .env

# Camera Source: 0 for USB/CSI webcam, or rtsp://IP:PORT/path for RTSP stream
CAMERA_SOURCE=0

# Model and inference configuration
YOLO_MODEL=backend/models/yolo26n.onnx
YOLO_INPUT_SIZE=640
YOLO_INFERENCE_FPS=5
YOLO_INTRA_OP_THREADS=3
SHELF_ANALYSIS_INTERVAL=1.0
DETECTION_CONFIDENCE_THRESHOLD=0.40

# Database and configuration paths
DATABASE_PATH=backend/retail.db
CONFIG_PATH=config.yaml

# System and Network
DEBUG_MODE=false
HOST=0.0.0.0
PORT=8000
